{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "es2020",
    "moduleResolution": "bundler",
    "allowJs": true,
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "typeRoots": ["./src/api/ai/generate/(utils)", "./node_modules/@types"],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@fedjobs/types": [
        "../../packages/types/src"
      ],
      "@fedjobs/utils": [
        "../../packages/utils/src"
      ],
      "@fedjobs/database": [
        "../../packages/database/src"
      ]
    },
    "noEmit": false
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "app/(routes)/api/ai/vectorize/[docName]",
    "app/(routes)/api/ai/parse/[id]",
    "src/api/ai/generate/(utils)/types.d.ts"
  ],
  "references": [
    {
      "path": "../../packages/types"
    },
    {
      "path": "../../packages/utils"
    },
    {
      "path": "../../packages/database"
    }
  ],
  
  "exclude": [
    "node_modules"
  ]
}
