{
  "name": "fedjobs-monorepo",
  "private": true,
  "packageManager": "pnpm@9.10.0",
  "scripts": {
    "generate-tree": "./generate-directory-tree.sh",
    "add-file-names": "node add-file-path-comments.js",
    "export-key-contents": "bash projectRefactor.sh",
    "export-key-contents-and-web": "bash projectRefactor.sh ./apps/web/app",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "build": "turbo run build", 
    "lint": "turbo run lint",

    
    "build:web": "turbo run build --filter=@fedjobs/web...",
    "build:api": "turbo run build --filter=@fedjobs/api...", 


    "dev:web": "turbo run dev --filter=@fedjobs/web...",
    "dev:api": "turbo run dev --filter=@fedjobs/api...",

   
    "deploy:api": "pnpm run build:api && railway up --service fedjobs-api --environment production", 
    "deploy:web": "vercel deploy --prod" 
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vercel": "^39.3.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4"
  },
  "overrides": {
    "@neondatabase/serverless": {
      "drizzle-orm": "0.38.2"
    }
  }
}