{
  "name": "fedjobs-monorepo",
  "private": true,
  "packageManager": "pnpm@9.10.0",
  "scripts": {
    "add-file-names": "node add-file-path-comments.js",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "web:dev": "pnpm --filter @fedjobs/web dev",
    "api:deploy": "railway up --service fedjobs-api --environment production",
    "web:deploy": "vercel --prod"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vercel": "^39.3.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4"
  },
  "overrides": {
    "@neondatabase/serverless": {
      "drizzle-orm": "0.38.2"
    }
  }
}
