{
  "name": "@fedjobs/crawler",
  "version": "0.1.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "lint": "eslint src/**/*.ts",
    "test": "vitest --run \"__tests__/**/*.spec.ts\"",
    "test:watch": "vitest \"__tests__/**/*.spec.ts\"",
    "test:watch:verbose": "vitest --watch --reporter verbose \"__tests__/**/*.spec.ts\"",
    "test:verbose": "vitest --run --reporter verbose \"__tests__/**/*.spec.ts\"",
    "test:coverage": "vitest --run --coverage \"__tests__/**/*.spec.ts\"",
    "test:coverage:watch": "vitest --watch --coverage \"__tests__/**/*.spec.ts\"",
    "open:coverage": "open ./coverage/index.html",
    "test:integration": "chmod +x ./run-integration-tests.sh && ./run-integration-tests.sh mock",
    "test:integration:mock": "chmod +x ./run-integration-tests.sh && ./run-integration-tests.sh mock",
    "test:integration:real": "chmod +x ./run-integration-tests.sh && ./run-integration-tests.sh real",
    "test:integration:openai": "INTEGRATION_TEST_MODE=real TEST_URL=https://openai.com/careers/search/?l=6252b4ed-714d-469a-a970-7a13101bac9d vitest run --config ./vitest.config.ts \"__tests__/integration/openai-crawl.test.ts\"",
    "test:all": "vitest --run \"__tests__/**/*.{spec,test}.ts\""
  },
  "dependencies": {
    "@fedjobs/database": "workspace:*",
    "@fedjobs/types": "workspace:*",
    "@fedjobs/utils": "workspace:*",
    "cheerio": "^1.0.0",
    "crawlee": "^3.13.0",
    "dotenv": "^16.4.7",
    "playwright": "^1.51.1",
    "reflect-metadata": "^0.2.1",
    "tsyringe": "^4.8.0"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@vitest/coverage-v8": "2.1.8",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}