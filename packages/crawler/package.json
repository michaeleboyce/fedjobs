{
  "name": "@fedjobs/crawler",
  "version": "0.1.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "lint": "eslint src/**/*.ts",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:watch:verbose": "vitest --watch --reporter verbose",
    "test:verbose": "vitest --run --reporter verbose",
    "test:coverage": "vitest --run --coverage",
    "test:coverage:watch": "vitest --watch --coverage",
    "open:coverage": "open ./coverage/index.html"
  },
  "dependencies": {
    "@fedjobs/database": "workspace:*",
    "@fedjobs/types": "workspace:*",
    "@fedjobs/utils": "workspace:*",
    "cheerio": "^1.0.0",
    "crawlee": "^3.13.0",
    "dotenv": "^16.4.7",
    "playwright": "^1.51.1",
    "reflect-metadata": "^0.2.1",
    "tsyringe": "^4.8.0"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@vitest/coverage-v8": "2.1.8",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}