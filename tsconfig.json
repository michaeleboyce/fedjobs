{
    "compilerOptions": {
      "target": "es2020",
      "lib": ["dom", "dom.iterable", "esnext"],
      "module": "esnext",
      "moduleResolution": "node",
      "esModuleInterop": true,
      "skipLibCheck": true,
      "strict": true,
      "forceConsistentCasingInFileNames": true,
      "resolveJsonModule": true,
      "isolatedModules": true,
      "incremental": true,
      "composite": true
    },
    "references": [
        { "path": "packages/types" },
        { "path": "packages/utils" },
        { "path": "packages/database" },
        { "path": "apps/web" }
      ],
    "exclude": ["node_modules"]
  }